# Copy to .env and fill in real values. Never commit .env.
# Local run (H2, no database): no variables are needed at all.
# Docker Compose (postgres + redis): set POSTGRES_PASSWORD at least.

# PostgreSQL (used when SPRING_PROFILES_ACTIVE=postgres).
SPRING_PROFILES_ACTIVE=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/proddb
SPRING_DATASOURCE_USERNAME=produser
SPRING_DATASOURCE_PASSWORD=change-me

# Compose database credentials (the api reads POSTGRES_USER /
# POSTGRES_PASSWORD through the compose file).
POSTGRES_USER=produser
POSTGRES_PASSWORD=change-me

# Read cache: memory (default) or redis.
CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Rate limit, requests per minute per API key. Default 100.
APP_RATE_LIMIT_REQUESTS_PER_MINUTE=100
